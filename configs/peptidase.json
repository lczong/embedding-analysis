{
  "defaults": "defaults.json",
  "system": "peptidase",
  "metadata": {
    "id_column": "sequence_id",
    "class_column": "peptidase_class",
    "family_column": "peptidase_family",
    "files": {
      "train": "data/peptidase/metadata/peptidase_protein_train.metadata.tsv",
      "multi": "data/peptidase/metadata/peptidase_protein_cross_catalytic_2domain.metadata.tsv",
      "unseen": "data/peptidase/metadata/peptidase_protein_unseen.metadata.tsv"
    }
  },
  "classes": [
    "A",
    "C",
    "G",
    "M",
    "N",
    "S",
    "T"
