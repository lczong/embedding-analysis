  "class_colors": {
    "A": "#e6194b",
    "C": "#3cb44b",
    "G": "#b8860b",
    "M": "#4363d8",
    "N": "#911eb4",
    "S": "#f58231",
    "T": "#42d4f4"
  },
  "role_labels": {
    "train": "Peptidase",
    "ood": "Non-peptidase",
    "shuffled": "Shuffled",
    "idr": "IDR"
